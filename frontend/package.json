{
  "name": "tmws-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "ng": "ng",
    "build": "ng build",
    "start": "ng serve --open",
    "eslint": "eslint .",
    "eslint:fix": "eslint . --fix",
    "stylelint": "stylelint .",
    "stylelint:fix": "stylelint . --fix",
    "test": "ng test",
    "test:coverage": "ng test --coverage ",
    "test:ui": "ng test --ui",
    "test:ui:coverage": "ng test --ui --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "browserslist": [
    "last 1 Chrome version",
    "last 1 Firefox version",
    "last 2 Edge major versions",
    "last 2 Safari major versions",
    "Firefox ESR"
  ],
  "dependencies": {
    "@angular/common": "^22.1.2",
    "@angular/compiler": "^22.1.2",
    "@angular/core": "^22.1.2",
    "@angular/forms": "^22.1.2",
    "@angular/platform-browser": "^22.1.2",
    "@angular/router": "^22.1.2",
    "@ng-icons/bootstrap-icons": "^35.0.1",
    "@ng-icons/core": "^35.0.1",
    "@ng-select/ng-select": "^24.0.1",
    "@stomp/stompjs": "^7.3.0",
    "ngxsmk-datepicker": "^3.0.4",
    "rxjs": "^7.8.2",
    "sweetalert2": "^11.26.25",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.1.0",
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "angular-eslint": "^22.1.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "happy-dom": "^20.11.2",
    "playwright-coverage-reporter": "^3.1.23",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-prettier": "^5.0.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
