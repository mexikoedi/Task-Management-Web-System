    "@ng-icons/core": "^36.0.0",
    "@ng-select/ng-select": "^24.1.1",
    "@stomp/stompjs": "^7.3.0",
    "ngxsmk-datepicker": "^3.0.5",
    "rxjs": "^7.8.2",
    "sweetalert2": "^11.26.25",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.4.0",
