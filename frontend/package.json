    "@ng-icons/core": "^34.0.0",
    "@ng-select/ng-select": "^23.2.0",
    "@stomp/stompjs": "^7.3.0",
    "ngxsmk-datepicker": "^2.3.1",
    "rxjs": "^7.8.2",
    "sweetalert2": "^11.26.25",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.0.0",
