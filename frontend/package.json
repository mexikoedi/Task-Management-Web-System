{
  "name": "tmws-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "ng": "ng",
    "build": "ng build",
    "start": "ng serve --open",
    "eslint": "eslint .",
    "eslint:fix": "eslint . --fix",
    "stylelint": "stylelint .",
    "stylelint:fix": "stylelint . --fix",
    "test": "ng test",
    "test:coverage": "ng test --coverage ",
    "test:ui": "ng test --ui",
    "test:ui:coverage": "ng test --ui --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "browserslist": [
    "last 1 Chrome version",
    "last 1 Firefox version",
    "last 2 Edge major versions",
    "last 2 Safari major versions",
    "Firefox ESR"
  ],
  "dependencies": {
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@ng-icons/bootstrap-icons": "^36.1.0",
    "@ng-icons/core": "^36.1.0",
    "@ng-select/ng-select": "^24.2.1",
    "@stomp/stompjs": "^7.5.0",
    "ngxsmk-datepicker": "^3.0.6",
    "rxjs": "^7.8.2",
    "sweetalert2": "^11.26.25",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.6.0",
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@soroush.tech/playwright-coverage": "^3.1.2",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "happy-dom": "^21.0.4",
    "monocart-coverage-reports": "^3.2.0",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-prettier": "^5.0.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
